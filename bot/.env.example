DISCORD_TOKEN = <token>
DATABASE_URL = mongodb+srv://<username>:<db_password>@<cluster_name>.zgsgbzx.mongodb.net/
LOG_GUILD_ID = <guildId>
LOG_CHANNEL_ID = <channelId>
LAVALINK_PORT = <node_port>
LAVALINK_HOST = <node_ip>
LAVALINK_PASS = <node_password>
LAVALINK_SECURE = <boolean>

# API Server
API_PORT = 3001

# RapidAPI (Billboard Charts) - https://rapidapi.com/SUSPENDED/api/billboard-api2
RAPIDAPI_KEY = <your_rapidapi_key>

# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
# Used for checking if a video is music content (categoryId=10)
# Quota: 10,000 units/day, videos.list costs 1 unit per call
YOUTUBE_API_KEY = <your_youtube_api_key>

# Firebase Admin SDK
FIREBASE_PROJECT_ID = <projectId>
FIREBASE_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\n<private_key>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL = <client_email>