# Narze v7 — environment variables. Copy what you need into your shell or a local .env (never commit one).
# Local values for Supabase come from `bunx supabase@3 status -o env` after `bun run infra:up`.

# --- Bot (apps/bot) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
REDIS_URL=redis://127.0.0.1:6379
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# --- Lavalink / LavaSrc Spotify (read by docker compose) — leave unset for YouTube-only search ---
LAVASRC_SPOTIFY_ENABLED=false
LAVASRC_SPOTIFY_CLIENT_ID=
LAVASRC_SPOTIFY_CLIENT_SECRET=

# --- Backend (apps/backend) ---
BACKEND_PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000
# Rate limits key on the client's address (#142). X-Forwarded-For is believed only from this machine
# (cloudflared on the same host) and from these proxy addresses, comma-separated: set it when the proxy
# reaches the Backend from another address (cloudflared in Docker: its container IP). Otherwise every
# client behind that proxy shares one budget.
TRUSTED_PROXIES=
SUPABASE_URL=http://127.0.0.1:54321
# Secret key: server only, bypasses RLS. Never expose to the Dashboard.
SUPABASE_SECRET_KEY=
DISCORD_API_URL=https://discord.com/api/v10

# --- Dashboard (apps/dashboard) — inlined at build time, so public by design ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Auth's Discord provider (read by `supabase start`) ---
# Leave all three unset to use the fake Discord (bun run infra:up). For real Discord, set all three
# and add <SUPABASE_URL>/auth/v1/callback as a redirect in the Discord developer portal.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_URL=https://discord.com

# Bot Track Resolution (#104). Leave empty to classify from Lavalink's data and use avatars.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Embed author icon: botavatar | userimage | playlist_thumbnail | artistImage (v5 defaults below)
ICON_NORMAL_TRACK=artistImage
ICON_PLAYLIST_DISPLAY=botavatar
ICON_PLAYLIST_TRACK=artistImage
# true: a playlist track's notice links to the playlist instead of the track
USE_PLAYLIST_URL=false

# Backend catalog search (#105, ADR-0009) uses LAVALINK_* above and SPOTIFY_* / YOUTUBE_API_KEY.
# Only end-to-end tests set these, to point the Backend at a fake Spotify.
SPOTIFY_API_URL=
SPOTIFY_ACCOUNTS_URL=

# Bot Guild Settings (#106): the Bot reads and writes guild_settings in Supabase in both Runtime
# Modes (ADR-0003) with the same SUPABASE_URL / SUPABASE_SECRET_KEY as the Backend.
# Command audit log channel (spec #13) and the Dashboard the 30 % promo points at (spec #34).
LOG_GUILD_ID=
LOG_CHANNEL_ID=
DASHBOARD_URL=

# Listening Sessions not yet saved to Supabase survive a crash in this folder (#108).
# HISTORY_DIR=.data

# Charts (#109, ADR-0010): Apple Music RSS. Leave unset for the real feed; tests point it at a fake.
# CHARTS_URL=https://rss.marketingtools.apple.com

# Admin area (#110): Discord IDs that are always Developers (comma-separated). The only way in on a
# fresh database; they cannot be removed from the Dashboard.
# NARZE_DEVELOPER_IDS=
